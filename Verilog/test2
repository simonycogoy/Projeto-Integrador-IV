// ----------------------------------------------------------------------
// ARQUIVO 1: drrip.v
// ----------------------------------------------------------------------
module drrip
(
    input  wire        clk,
    input  wire        rst,
    input  wire        access_valid,
    input  wire        access_is_hit,
    input  wire [IDX_W-1:0] set_idx,
    input  wire [3:0]  valid_vec,
    input  wire [1:0]  hit_way,
    input  wire        refill_valid,
    output reg  [1:0]  victim_way,
    output reg         victim_found,
    output reg  [1:0]  insert_rrpv,
    output reg         psel_msb_policy
);

    parameter SETS     = 64;
    parameter IDX_W    = 6;
    parameter PSEL_BITS = 10;

    // 2 bits de RRPV por cada way (4 ways) de cada set
    reg [1:0] rrpv_mem [0:SETS-1][0:3];

    // SRRIP leader: set_idx[1:0] == 2'b00; BRRIP leader: set_idx[1:0] == 2'b11
    wire is_srrip_leader = (set_idx[1:0] == 2'b00);
    wire is_brrip_leader = (set_idx[1:0] == 2'b11);

    // PSEL saturado, incrementa no hit SRRIP, decrementa no hit BRRIP
    reg [PSEL_BITS-1:0] psel;

    // Contador deterministico para BRRIP raro (inserir 2'b10)
    reg [3:0] brrip_counter;

    // Sinais combinacionais para refill
    reg [1:0] invalid_way;
    reg       has_invalid;
    reg [1:0] victim_rrpv3;
    reg       has_rrpv3;
    reg [1:0] max_rrpv;
    reg [1:0] delta;
    reg [1:0] aged_rrpv;
    reg [1:0] chosen_way;
    reg       chosen_found;
    reg [1:0] i;
    reg [1:0] j;
    reg [1:0] k;
    reg [1:0] m;
    reg [1:0] policy;

    // Inicializacao e reset
    integer s;
    integer w;
    always @(posedge clk or posedge rst) begin
        if (rst) begin
            psel <= {PSEL_BITS{1'b0}};
            brrip_counter <= 4'b0000;
            for (s = 0; s < SETS; s = s + 1) begin
                for (w = 0; w < 4; w = w + 1) begin
                    rrpv_mem[s][w] <= 2'b00;
                end
            end
        end else begin
            brrip_counter <= brrip_counter + 1;
            // Atualizacao de PSEL e hit: so atua quando acesso valido
            if (access_valid) begin
                if (access_is_hit) begin
                    // Hit: a way acessada vai para RRPV 0
                    rrpv_mem[set_idx][hit_way] <= 2'b00;
                    // PSEL: SRRIP leader incrementa, BRRIP leader decrementa
                    if (is_srrip_leader) begin
                        if (psel < {PSEL_BITS{1'b1}})
                            psel <= psel + 1;
                    end else if (is_brrip_leader) begin
                        if (psel > {PSEL_BITS{1'b0}})
                            psel <= psel - 1;
                    end
                end
            end
        end
    end

    // Combinacional de refill: sempre calcular vítima e policy
    always @(*) begin
        // Defaults
        invalid_way = 2'b00;
        has_invalid = 1'b0;
        victim_rrpv3 = 2'b00;
        has_rrpv3 = 1'b0;
        max_rrpv = 2'b00;
        delta = 2'b00;
        chosen_way = 2'b00;
        chosen_found = 1'b0;
        policy = 2'b00;
        victim_way = 2'b00;
        victim_found = 1'b0;
        insert_rrpv = 2'b10;
        psel_msb_policy = psel[PSEL_BITS-1];

        // Policy de insercao
        if (is_srrip_leader) begin
            policy = 2'b00; // SRRIP
        end else if (is_brrip_leader) begin
            policy = 2'b01; // BRRIP
        end else begin
            // Follower segue MSB de PSEL
            if (psel_msb_policy)
                policy = 2'b01; // BRRIP
            else
                policy = 2'b00; // SRRIP
        end

        // Define insert_rrpv segundo a politica
        if (policy == 2'b00) begin
            // SRRIP sempre insere distante (2'b10)
            insert_rrpv = 2'b10;
        end else begin
            // BRRIP simplificado: raramente 2'b10, normalmente 2'b11
            if (brrip_counter == 4'b0000)
                insert_rrpv = 2'b10;
            else
                insert_rrpv = 2'b11;
        end

        if (refill_valid) begin
            // 1) Procura primeira way invalida
            for (i = 0; i < 4; i = i + 1) begin
                if (!has_invalid && (valid_vec[i] == 1'b0)) begin
                    has_invalid = 1'b1;
                    invalid_way = i;
                end
            end

            if (has_invalid) begin
                victim_way   = invalid_way;
                victim_found = 1'b1;
            end else begin
                // 2) Procura primeira way com RRPV == 3
                for (j = 0; j < 4; j = j + 1) begin
                    if (!has_rrpv3 && (rrpv_mem[set_idx][j] == 2'b11)) begin
                        has_rrpv3 = 1'b1;
                        victim_rrpv3 = j;
                    end
                end

                if (has_rrpv3) begin
                    victim_way   = victim_rrpv3;
                    victim_found = 1'b1;
                end else begin
                    // 3) Aging: encontra maior RRPV, calcula delta ate 3
                    max_rrpv = 2'b00;
                    for (k = 0; k < 4; k = k + 1) begin
                        if (rrpv_mem[set_idx][k] > max_rrpv)
                            max_rrpv = rrpv_mem[set_idx][k];
                    end
                    // delta = 3 - max_rrpv, saturado em 2 bits
                    delta = 2'b11 - max_rrpv;

                    chosen_found = 1'b0;
                    chosen_way   = 2'b00;
                    for (m = 0; m < 4; m = m + 1) begin
                        aged_rrpv = rrpv_mem[set_idx][m] + delta;
                        if (aged_rrpv > 2'b11)
                            aged_rrpv = 2'b11;
                        if (!chosen_found && (aged_rrpv == 2'b11)) begin
                            chosen_found = 1'b1;
                            chosen_way   = m;
                        end
                    end
                    victim_way   = chosen_way;
                    victim_found = chosen_found;
                end
            end
        end
    end

    // Sincroniza o aging na memoria de RRPV (apenas em refill com todas validas e nenhuma RRPV=3)
    // Tambem atualiza o RRPV do novo bloco inserido (vítima) com insert_rrpv
    // Nota: a vítima combinacional pode ser registrada; aqui, simplificamos: atualizamos RRPV no set no ciclo de refill
    always @(posedge clk or posedge rst) begin
        if (!rst) begin
            if (refill_valid) begin
                if (!has_invalid && !has_rrpv3) begin
                    // Aplica o aging nas 4 ways
                    for (k = 0; k < 4; k = k + 1) begin
                        aged_rrpv = rrpv_mem[set_idx][k] + delta;
                        if (aged_rrpv > 2'b11)
                            aged_rrpv = 2'b11;
                        rrpv_mem[set_idx][k] <= aged_rrpv;
                    end
                end
                // Escreve o RRPV de insercao na vítima
                if (victim_found)
                    rrpv_mem[set_idx][victim_way] <= insert_rrpv;
            end
        end
    end

endmodule
